#include<stdio.h>
struct details{
    int student_id;
    char student_name[50];
    int student_age;
};
void create(){
    FILE *fp;
    struct details stu;
    fp=fopen("student.txt","a");

    if(fp==NULL){
        printf("File cannot be opened.\n");
        return ;
    }

    printf("Enter student id: ");
    scanf("%d",&stu.student_id);

    printf("Enter student name: ");
    scanf("%s",stu.student_name);

    printf("Enter student age: ");
    scanf("%d",&stu.student_age);

    fprintf(fp,"%d %s %d\n",stu.student_id,stu.student_name,stu.student_age);

    fclose(fp);
    printf("Student record created successfully.\n");
}
void read(){
    FILE* fp;
    struct details stu;

    fp=fopen("student.txt","r");
    if(fp==NULL){
        printf("File not found.\n");
        return;
    }
    while(fscanf(fp,"%d %s %d",&stu.student_id,stu.student_name,&stu.student_age)!=EOF){
        printf("Student ID: %d\n",stu.student_id);
        printf("Student Name: %s\n",stu.student_name);
        printf("Student Age: %d\n",stu.student_age);
    }
    fclose(fp);
}   

void update(){
    FILE *fp,*new;
    struct details stu;
    int target_id;
    
    fp=fopen("student.txt","r");
    new=fopen("temp.txt","w");

    if(fp==NULL||new==NULL){
        printf("file cannot be opened.\n");
        return ;
    }

    printf("Enter student id to update: ");
    scanf("%d",&target_id);

    while(fscanf(fp,"%d %s %d",&stu.student_id,stu.student_name,&stu.student_age)!=EOF){
            if(stu.student_id==target_id){
                printf("Enter new student name: ");
                scanf("%s",stu.student_name);
                printf("Enter new student age: ");
                scanf("%d",&stu.student_age);
            }
           fprintf(new,"%d %s %d\n",
            stu.student_id,
            stu.student_name,
            stu.student_age);
        }
     fclose(fp);
     fclose(new);
     remove("student.txt");
     rename("temp.txt","student.txt");
     printf("Student record updated successfully.\n");

}
void delete(){
    FILE *fp,*new;
    struct details stu;
    int target_id;

    fp=fopen("student.txt","r");
    new=fopen("temp.txt","w");

    if(fp==NULL||new==NULL){
        printf("This file cannot be opened.\n");
        return;
    }

    printf("Enter student id to delete: ");
    scanf("%d",&target_id);

    while(fscanf(fp,"%d %s %d",&stu.student_id,stu.student_name,&stu.student_age)!=EOF){
        if(stu.student_id!=target_id){
            fprintf(new,"%d %s %d\n",
                stu.student_id,
                stu.student_name,
                stu.student_age);
        }
    }
    fclose(fp);
    fclose(new);
    remove("student.txt");
    rename("temp.txt","student.txt");
    printf("Student record deleted successfully.\n");
}
  

