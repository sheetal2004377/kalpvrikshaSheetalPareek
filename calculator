#include<stdio.h>
int is_digit(char ch){
    return ch>='0'&&ch<='9';
}
int is_operator(char ch){
    return ch=='+'||ch=='-'||ch=='*'||ch=='/';
}
int evaluate_expression(char expression[],int *answer){
    int i=0;
    int current_val=0;
    int value=0;
    char current_operator='+';
    int need_number=1;
    while(expression[i]!='\0'){
        if(expression[i]==' '||expression[i]=='\n'){
            i++;
            continue;
        }
        if(is_digit(expression[i])){
            if(need_number==0){
                return 1;
            }
            need_number=0;
            value=0;
            while(is_digit(expression[i])){
                value=value*10+(expression[i]-'0');
                i++;
            }
            if(current_operator=='*'){
                current_val=current_val*value;
            }
            else if(current_operator=='/'){
                if(value==0){
                    return 2;
                }
                current_val=current_val/value;
            }
            else{
                *answer=*answer+current_val;
                if(current_operator=='-'){
                    current_val=-value;
                }
                else{
                    current_val=value;
                }
            }
        }
        else if(is_operator(expression[i])){
            if(need_number){
                return 1;
            }
            need_number=1;
            current_operator=expression[i];
            i++;
        }
        else{
            return 1;
        }

    }
    if(need_number){
        return 1;
    }
    *answer=*answer+current_val;
    return 0;

}
int main()
{
    char expression[100];
    int answer = 0;
    int status;

    printf("Enter the expression: ");
    fgets(expression, sizeof(expression), stdin);

    status = evaluate_expression(expression, &answer);

    if (status == 2)
    {
        printf("Error: Division by zero.\n");
    }
    else if (status == 1)
    {
        printf("Error: Invalid expression.\n");
    }
    else
    {
        printf("%d\n", answer);
    }

    return 0;
}
